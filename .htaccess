# Kasir Minimarket — root project.
# Document root server SEHARUSNYA diarahkan ke folder public/ (vhost
# Laragon/Apache/Nginx). .htaccess ini pengaman cadangan: folder
# internal (config, database, src, test, vendor, .git, dll.) diblokir
# 403, sementara URL pendek tetap di-redirect ke public/.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ------------------------------------------------------------
    # 1. Blokir akses ke folder & file internal (403)
    # ------------------------------------------------------------
    RewriteRule ^(\.git|\.commandcode|config|database|src|test|vendor)(/|$) - [F,L]
    RewriteRule ^(composer\.json|composer\.lock|\.env(\.\w+)?|phpinfo.*\.php|opcache.*\.php)$ - [F,L]

    # ------------------------------------------------------------
    # 2. Redirect URL pendek ke folder public/
    # ------------------------------------------------------------
    RewriteRule ^/?$ public/login.php [L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
